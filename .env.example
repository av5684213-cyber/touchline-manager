# Touchline Manager — Environment Variables
# Bu dosyayı kendi .env dosyanızı oluşturmak için şablon olarak kullanın.
# Gerçek değerleri .env dosyasına yazın (.env gitignore'da, commit edilmez).

# Supabase — public (client-side)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — service role (sadece server-side, ASLA client'a expose etme)
SUPABASE_SERVICE_ROLE_KEY=

# Cron job'lar için shared secret (Vercel cron header'ı doğrulamak için)
CRON_SECRET=

# Auth (varsa)
NEXTAUTH_SECRET=

# v2.9.147: Sentry — Crash & Error Reporting
# Sentry dashboard'undan aldığınız DSN (https://xxx@yyy.ingest.sentry.io/123)
# Boş bırakılırsa Sentry devre dışı kalır (geliştirme modu).
NEXT_PUBLIC_SENTRY_DSN=
# App version (release tracking için)
NEXT_PUBLIC_APP_VERSION=2.9.147
