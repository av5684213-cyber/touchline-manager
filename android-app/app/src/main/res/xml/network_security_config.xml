<?xml version="1.0" encoding="utf-8"?>
<!--
  ════════════════════════════════════════════════════════════════════════════
  NETWORK SECURITY CONFIG — v2.9.52
  ════════════════════════════════════════════════════════════════════════════
  Tüm trafik HTTPS zorunlu. Cleartext (HTTP) tamamen yasak.

  - Varsayılan: cleartextTrafficPermitted = false (tüm domain'ler)
  - Supabase domain'i: HTTPS only (pinning yok ama HTTPS zorunlu)
  - Mixed content: native seviyede MIXED_CONTENT_NEVER_ALLOW ile engelli

  v2.9.52: localhost/127.0.0.1 cleartext istisnası KALDIRILDI.
  (Eğer local dev için gerekirse debug build type'a ayrı config taşınmalı)
  ════════════════════════════════════════════════════════════════════════════
-->
<network-security-config>
    <!-- Varsayılan: tüm domain'ler için cleartext yasak -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Supabase domain'i — HTTPS zorunlu, certificate pinning yok -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">supabase.co</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
